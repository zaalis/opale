{
  "name": "opale",
  "version": "0.1.0",
  "description": "Opale — carnet de notes Markdown local, relié par des liens, avec graphe et connexion MCP pour zaalis IDE.",
  "main": "server.js",
  "bin": "server.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js --window",
    "serve": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "build": "bash native/build.sh",
    "package": "bash native/package.sh",
    "install-local": "bash native/install.sh"
  },
  "pkg": {
    "assets": [
      "interface/**/*",
      "shared/**/*"
    ]
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
