#include <winver.h>

1 ICON "opale.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "zaalis"
            VALUE "FileDescription", "Opale"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "Opale"
            VALUE "OriginalFilename", "Opale.exe"
            VALUE "ProductName", "Opale"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 0x04B0
    END
END
